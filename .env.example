# Copy the section you want into `.env` or inject the same keys through Docker/Kubernetes.
# Supported APP_ENV values: dev, uat, prod.

# Common knobs
# APP_ENV=dev
# PORT=8080
# SHUTDOWN_TIMEOUT=10s
# WORKER_INTERVAL=15s
# HEALTH_PORT=8081
# MINIO_USE_SSL=false
# MINIO_REGION=us-east-1

# Development
APP_ENV=dev
PORT=8080
SHUTDOWN_TIMEOUT=10s
WORKER_INTERVAL=15s
HEALTH_PORT=8081
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agnos-dev-records
MINIO_REGION=us-east-1
MINIO_RECORD_PREFIX=dev/records
MINIO_USE_SSL=false

# UAT
# APP_ENV=uat
# PORT=8080
# SHUTDOWN_TIMEOUT=15s
# WORKER_INTERVAL=30s
# HEALTH_PORT=8081
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=uat-minio-user
# MINIO_SECRET_KEY=uat-minio-password
# MINIO_BUCKET=agnos-uat-records
# MINIO_REGION=us-east-1
# MINIO_RECORD_PREFIX=uat/records
# MINIO_USE_SSL=false

# Production
# APP_ENV=prod
# PORT=8080
# SHUTDOWN_TIMEOUT=20s
# WORKER_INTERVAL=1m
# HEALTH_PORT=8081
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=prod-minio-user
# MINIO_SECRET_KEY=prod-minio-password
# MINIO_BUCKET=agnos-prod-records
# MINIO_REGION=us-east-1
# MINIO_RECORD_PREFIX=prod/records
# MINIO_USE_SSL=false
